# =============================================
# AI 智能绘图系统 - 环境变量配置
# 默认使用国内大模型（通义千问 Qwen / DeepSeek）
# =============================================

# --- 模型提供商预设（二选一，或选 custom 自定义）---
# 可选值: qwen | deepseek | qwen-turbo | deepseek-reasoner | custom
# qwen              → 通义千问 Qwen-Plus（阿里云 DashScope）
# qwen-turbo        → 通义千问 Qwen-Turbo（更快更便宜）
# deepseek          → DeepSeek Chat
# deepseek-reasoner → DeepSeek R1 推理模型
# custom            → 需手动填写 LLM_BASE_URL 和 LLM_MODEL
LLM_PROVIDER=qwen

# --- API Key（必填）---
# 通义千问申请: https://dashscope.console.aliyun.com/apiKey
# DeepSeek申请: https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-你的API密钥

# --- 以下两项仅在 LLM_PROVIDER=custom 时需要填写 ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- 生成参数 ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- 服务端口 ---
APP_PORT=8000
